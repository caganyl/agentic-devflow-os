#!/bin/sh
# devflow-manifest — bir REQ için draft ownership manifesti üretir.
#
#   devflow-manifest <REQ-no> [TARGET_DIR]      örn: devflow-manifest 002
#
# scripts/devflow_new_manifest.sh'i çağırır. Manifest her zaman "draft"
# üretilir; "approved" yapmak insan adımıdır.
#
# DEVFLOW_HOME framework repo köküdür; verilmezse bu dosyanın bir üst klasörü.
set -eu

DEVFLOW_HOME="${DEVFLOW_HOME:-$(cd "$(dirname "$0")/.." && pwd -P)}"
exec bash "$DEVFLOW_HOME/scripts/devflow_new_manifest.sh" "$@"
