#!/bin/sh
# claude-devflow — DevFlow'u yükleyerek Claude Code oturumu açar.
#
#   claude-devflow [claude argümanları...]
#       Bulunulan klasörü scripts/devflow_bootstrap.sh ile hazırlar (plugin
#       eskiyse build, git + req-001-bootstrap branch, CLAUDE.md, rule'lar,
#       docs iskeleti, REQ-001 manifesti, .devflow/) ve
#       `claude --plugin-dir dist/devflow-plugin` başlatır.
#
#   claude-devflow launch --objective "REQ-NNN: ..." --req-id REQ-NNN [--dry-run] [--agent-teams]
#       Bulunulan proje için managed run başlatır
#       (scripts/devflow_operations.py launch --target "$PWD" ...).
#
#   claude-devflow office [--demo] [--port N] [--no-open]
#       Aktif DevFlow projelerini canlı ofis görünümünde sekmeler halinde açar
#       (scripts/devflow_office.py; yalnızca 127.0.0.1, salt okunur).
#       --share: bu bilgisayarın ofislerini yerel ağda token'la paylaşır;
#       --remote HOST --token T: paylaşılan ofisi uzak sekme olarak ekler.
#
#   claude-devflow map [status|affected|explain|path|query ...]
#       Bulunulan proje için Graphify kod haritasını kurar/günceller
#       (opsiyonel; graphify kurulu olmalı, yalnızca yerel AST).
#
#   claude-devflow doctor     Ön koşulları ve kurulumu kontrol eder.
#   claude-devflow --help     Bu yardımı gösterir.
#
# Ponytail (yalın implementasyon kuralları) node varsa ikinci plugin olarak
# yüklenir ve yalnızca implementer/QA alt ajanlarına verilir. Kapatmak için
# DEVFLOW_PONYTAIL=0. Kaynak: .claude/vendor/ponytail/VENDORED.md
#
# Kurulum: framework repo kökünde `./bin/install` (PATH'e symlink ekler).
# DEVFLOW_HOME framework repo köküdür; verilmezse bu dosyanın gerçek konumunun
# (symlink'ler çözülerek) bir üst klasörü.
set -eu

# PATH'teki symlink'ten çağrıldığında $0 symlink'i gösterir; framework
# kökünü bulmak için gerçek dosyaya kadar izle (macOS'ta readlink -f yok).
self_dir() {
  p="$0"
  while [ -L "$p" ]; do
    d="$(cd "$(dirname "$p")" && pwd -P)"
    l="$(readlink "$p")"
    case "$l" in
      /*) p="$l" ;;
      *) p="$d/$l" ;;
    esac
  done
  cd "$(dirname "$p")" && pwd -P
}

DEVFLOW_HOME="${DEVFLOW_HOME:-$(cd "$(self_dir)/.." && pwd -P)}"
export DEVFLOW_HOME
PLUGIN_DIR="$DEVFLOW_HOME/dist/devflow-plugin"
PONYTAIL_DIR="$DEVFLOW_HOME/.claude/vendor/ponytail"
# Ponytail kurallarını alan alt ajanlar (agent_type içinde aranan regex).
PONYTAIL_ROLES="backend-engineer|frontend-engineer|database-engineer|ai-data-engineer|qa-automation"

# Ponytail hook'ları node ile çalışır; node yoksa veya DEVFLOW_PONYTAIL=0 ise yüklenmez.
ponytail_enabled() {
  [ "${DEVFLOW_PONYTAIL:-1}" != "0" ] &&
    [ -f "$PONYTAIL_DIR/.claude-plugin/plugin.json" ] &&
    command -v node >/dev/null 2>&1
}

die() {
  printf 'claude-devflow: %s\n' "$*" >&2
  exit 1
}

usage() {
  sed -n '2,33p' "$DEVFLOW_HOME/bin/claude-devflow" | sed 's/^# \{0,1\}//'
  printf '\nDEVFLOW_HOME: %s\n' "$DEVFLOW_HOME"
}

# Hook'lar jq ve python3 olmadan fail-closed reddeder; eksikse baştan söyle.
missing_tools() {
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || printf '%s ' "$tool"
  done
}

[ -f "$DEVFLOW_HOME/scripts/devflow_bootstrap.sh" ] ||
  die "DEVFLOW_HOME bir DevFlow framework repo'su değil: $DEVFLOW_HOME"

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  doctor)
    status=0
    printf 'DEVFLOW_HOME: %s\n' "$DEVFLOW_HOME"
    for tool in git python3 jq claude; do
      if path="$(command -v "$tool" 2>/dev/null)"; then
        printf '  [ok]     %-8s %s\n' "$tool" "$path"
      else
        printf '  [eksik]  %s\n' "$tool"
        status=1
      fi
    done
    if [ -f "$PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
      printf '  [ok]     plugin   %s\n' "$PLUGIN_DIR"
    else
      printf '  [yok]    plugin   ilk çalıştırmada build edilir\n'
    fi
    if [ "${DEVFLOW_PONYTAIL:-1}" = "0" ]; then
      printf '  [kapalı] ponytail DEVFLOW_PONYTAIL=0\n'
    elif ! command -v node >/dev/null 2>&1; then
      printf '  [uyarı]  ponytail node yok; ponytail yüklenmeyecek\n'
    elif ponytail_enabled; then
      printf '  [ok]     ponytail %s\n' "$PONYTAIL_DIR"
    else
      printf '  [uyarı]  ponytail %s bulunamadı\n' "$PONYTAIL_DIR"
    fi
    if command -v graphify >/dev/null 2>&1; then
      printf '  [ok]     graphify %s (opsiyonel kod haritası)\n' "$(graphify --version 2>/dev/null | awk '{print $NF}')"
    else
      printf '  [yok]    graphify opsiyonel; kod haritası için: uv tool install graphifyy==0.9.93\n'
    fi
    if command -v claude-devflow >/dev/null 2>&1; then
      printf '  [ok]     PATH     %s\n' "$(command -v claude-devflow)"
    else
      printf '  [eksik]  PATH     claude-devflow PATH üzerinde değil (./bin/install)\n'
      status=1
    fi
    exit "$status"
    ;;
  map)
    shift
    command -v python3 >/dev/null 2>&1 || die "eksik araç: python3 (claude-devflow doctor)"
    if [ "$#" -eq 0 ]; then
      set -- build
    fi
    exec python3 "$DEVFLOW_HOME/scripts/devflow_code_map.py" "$@"
    ;;
  office)
    shift
    command -v python3 >/dev/null 2>&1 || die "eksik araç: python3 (claude-devflow doctor)"
    exec python3 "$DEVFLOW_HOME/scripts/devflow_office.py" --target "$PWD" "$@"
    ;;
  launch)
    shift
    missing="$(missing_tools git python3 jq claude)"
    [ -z "$missing" ] || die "eksik araç: $missing(claude-devflow doctor)"
    exec python3 "$DEVFLOW_HOME/scripts/devflow_operations.py" launch --target "$PWD" "$@"
    ;;
esac

missing="$(missing_tools git python3 jq claude)"
[ -z "$missing" ] || die "eksik araç: $missing(claude-devflow doctor)"

bash "$DEVFLOW_HOME/scripts/devflow_bootstrap.sh" "$PWD"

# Bootstrap framework repo içinde hiçbir şey yapmadan çıkar; plugin yine de gerekir.
if [ ! -f "$PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
  python3 "$DEVFLOW_HOME/scripts/build_devflow_plugin.py" >/dev/null
fi

if ponytail_enabled; then
  # ultra isteği sorgular; onaylı REQ/AC ile çalışan DevFlow'da kullanılmaz.
  case "${PONYTAIL_DEFAULT_MODE:-}" in
    lite|off) ;;
    *) PONYTAIL_DEFAULT_MODE=full ;;
  esac
  PONYTAIL_SUBAGENT_MATCHER="${PONYTAIL_SUBAGENT_MATCHER:-$PONYTAIL_ROLES}"
  export PONYTAIL_DEFAULT_MODE PONYTAIL_SUBAGENT_MATCHER
  exec claude --plugin-dir "$PLUGIN_DIR" --plugin-dir "$PONYTAIL_DIR" "$@"
fi
exec claude --plugin-dir "$PLUGIN_DIR" "$@"
