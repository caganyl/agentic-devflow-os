{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-devflow-os/docs/ownership/schema.json",
  "title": "Task Ownership Manifest",
  "description": "REQ-ID bazlı, insan onaylı file ownership manifest standardı.",
  "type": "object",
  "required": [
    "schema_version",
    "req_id",
    "title",
    "status",
    "approval",
    "references",
    "owners"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "req_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "superseded", "closed"]
    },
    "approval": {
      "type": "object",
      "required": ["approved_by", "approved_at"],
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        }
      }
    },
    "references": {
      "type": "object",
      "required": [
        "requirement",
        "acceptance_criteria",
        "contracts",
        "contract_exception",
        "adrs"
      ],
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "string",
          "minLength": 1
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contract_exception": {
          "type": "object",
          "required": ["reason", "approved_by", "approved_at"],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string"
            },
            "approved_by": {
              "type": "string"
            },
            "approved_at": {
              "type": "string"
            }
          }
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent", "write_paths"],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "frontend-engineer",
              "backend-engineer",
              "database-engineer",
              "qa-automation",
              "ai-data-engineer"
            ]
          },
          "write_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
